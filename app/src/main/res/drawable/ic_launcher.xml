<?xml version="1.0" encoding="utf-8"?>
<!--
    QryptIN — ic_launcher.xml (adaptive icon)
    Background: solid color matched to the QryptIN brand logo.
    Foreground: the QryptIN peacock-feather "Q" mark (raster, all densities
    in mipmap-mdpi … mipmap-xxxhdpi), scaled to sit safely inside every
    launcher mask shape (circle, squircle, rounded square, teardrop).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
